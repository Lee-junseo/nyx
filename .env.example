# ──────────────────────────────────────────────────────
# EmailJS 설정 (https://www.emailjs.com/)
# ──────────────────────────────────────────────────────
# 설정 방법:
#  1. emailjs.com 에서 계정 생성
#  2. Email Services → Gmail 서비스 추가 → Service ID 복사
#  3. Email Templates → 새 템플릿 생성
#     사용 변수: {{user_email}}, {{worry}}, {{sent_at}}
#     예시 템플릿 제목: "[NYX] 새로운 별자리가 생성되었습니다"
#  4. Account → API Keys → Public Key 복사
#  5. 이 파일을 .env 로 복사 후 값 입력:
#     cp .env.example .env
# ──────────────────────────────────────────────────────

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
